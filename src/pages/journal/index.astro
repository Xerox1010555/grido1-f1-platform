---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/api";

const posts = getPosts();
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
---

<BaseLayout
  title="Journal — GRIDO1 Racing Systems"
  description="Race reports, milestones and features from AMER's 2026 season."
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="page-eyebrow">Stories from the track</p>
      <h1 class="page-title">Journal<span class="period">.</span></h1>
      <p class="page-lead">Race reports, milestones and features — written from inside the paddock.</p>
    </div>
  </section>

  <section class="page-section">
    <div class="page-section-inner">
      <div class="card-grid">
        {posts.map((post) => (
          <a class="card" href={`/journal/${post.slug}`}>
            <div class="card-body">
              <span class="card-eyebrow">{post.category} — {formatDate(post.date)} — {post.readMinutes} min</span>
              <h2 class="card-title">{post.title}</h2>
              <p class="card-text">{post.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
