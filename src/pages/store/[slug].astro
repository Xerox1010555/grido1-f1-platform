---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProducts } from "../../lib/api";

export function getStaticPaths() {
  return getProducts().map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const others = getProducts().filter((p) => p.slug !== product.slug).slice(0, 3);
---

<BaseLayout title={`${product.name} — Store | GRIDO1 Racing Systems`} description={product.tagline}>
  <section class="page-section">
    <div class="page-section-inner">
      <p class="page-eyebrow" style="color:var(--slate-600)"><a href="/store">← Store</a></p>
      <div style="margin-top:2rem;">
        <div>
          {product.badge && <span class="badge" style="position:static;display:inline-block;margin-bottom:1rem;">{product.badge}</span>}
          <h1 class="section-title" style="font-size:2.75rem">{product.name}</h1>
          <p class="card-eyebrow" style="margin:.75rem 0 1.5rem">{product.tagline}</p>
          <p style="font:700 2rem/1 var(--font-display);margin:0 0 1.5rem;">${product.price}.00 {product.currency}</p>
          <ul style="list-style:none;padding:0;display:grid;gap:.5rem;margin:0 0 2rem;">
            {product.description.map((line) => (
              <li style="font-size:.9375rem;line-height:1.5;color:var(--slate-600);text-transform:none;">— {line}</li>
            ))}
          </ul>
          {product.sizes && (
            <fieldset style="border:0;padding:0;margin:0 0 2rem;">
              <legend class="card-eyebrow" style="margin-bottom:.5rem">Size</legend>
              <div style="display:flex;gap:.5rem;flex-wrap:wrap;">
                {product.sizes.map((size, i) => (
                  <label style="cursor:pointer;">
                    <input type="radio" name="size" value={size} checked={i === 2} style="position:absolute;opacity:0;" />
                    <span style="display:inline-block;padding:.5rem .9rem;border:1px solid var(--border-muted);font-size:.875rem;">{size}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}
          <div style="display:flex;gap:1rem;flex-wrap:wrap;">
            <button class="cta" type="button" data-add-to-cart={product.slug} style="min-width:14rem;">
              <span>Add to cart</span>
              <svg viewBox="0 0 13.71 10.71" fill="none" aria-hidden="true"><path d="M0 5.35h13M8 10.35l5-5-5-5" stroke="currentColor" /></svg>
            </button>
            {product.stripePaymentLink && (
              <a class="cta cta--outline" href={product.stripePaymentLink}>
                <span>Buy now — Stripe</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="page-section page-section--dark">
      <div class="page-section-inner">
        <div class="section-head"><h2 class="section-title">More merch</h2></div>
        <div class="card-grid">
          {others.map((p) => (
            <a class="card" href={`/store/${p.slug}`}>
              <div class="card-body">
                <h3 class="card-title">{p.name}</h3>
                <p class="card-text" style="font-weight:700;color:var(--ink-950)">${p.price}.00</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
