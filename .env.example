# Copy to .env and fill in real values. NEVER commit .env.

# Canonical site origin (used for SEO tags + sitemap)
SITE_URL=https://grido1.example.com

# Stripe (store) — publishable key is safe to expose; secret key is NOT used client-side.
# Checkout is handled by a Stripe Payment Link per product (see src/data/products.json)
# or by your serverless checkout endpoint.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx

# Analytics — only loaded after the visitor consents via the cookie banner.
# Leave empty to disable entirely.
GA_MEASUREMENT_ID=

# Asset host override — defaults to the local /assets folder.
# If a local asset is missing the app falls back to this origin.
ASSET_FALLBACK_ORIGIN=https://storage.getlayers.ai
